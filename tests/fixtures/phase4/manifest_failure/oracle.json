{
  "scenario": "manifest_failure",
  "expected_terminal_counts": {
    "REJECTED": 1
  },
  "expected_outcome": "QUARANTINED",
  "expected_reason": "manifest_error",
  "agents": [
    {
      "id": "agent_1",
      "proposal": {
        "path": "package.json",
        "affected_symbols": [
          "package.json"
        ],
        "content": "{\n  \"name\": \"test\",\n  \"version\": \"1.0.0\",\n  \"dependencies\": {\n    \"express\": \"^4.17.1\"\n  }\n}\n"
      }
    }
  ],
  "golden_assertions": {
    "package.json": {
      "must_contain": [],
      "must_not_contain": [
        "express"
      ]
    }
  },
  "gate_config": {
    "gates": [
      {
        "name": "manifest_check",
        "command": "FAIL_CLOSED: malformed manifest",
        "timeout_seconds": 10
      }
    ]
  }
}